{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bangla Panjika",
  "version": "1.0.0",
  "identifier": "com.bongcalender.panjika",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev -- --port 5173",
    "beforeBuildCommand": "npm --prefix ../../packages/panjika-core run build && npm --prefix ../web run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "বাংলা পঞ্জিকা — Bengali Panjika",
        "width": 1320,
        "height": 880,
        "minWidth": 380,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
